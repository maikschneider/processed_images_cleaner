{
	"name": "derhansen/processed-images-cleaner-build",
	"description": "composer.json for builds",
	"repositories": [
		{
			"type": "path",
			"url": "../../"
		}
	],
	"require": {
		"derhansen/processed-images-cleaner": "@dev",
		"typo3/cms-core": "^13.4",
		"php": ">=8.2"
	},
	"require-dev": {
		"typo3/cms-composer-installers": "^5.0",
		"typo3/cms-backend": "^13.4",
		"typo3/cms-fluid": "^13.4",
		"typo3/cms-tstemplate": "^13.4",
		"typo3/cms-extensionmanager": "^13.4",
		"typo3/testing-framework": "^9.0",
		"friendsofphp/php-cs-fixer": "^3.12.0",
		"saschaegerer/phpstan-typo3": "^3.0",
		"phpstan/extension-installer": "^1.1"
	},
	"config": {
		"lock": false,
		"allow-plugins": {
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true,
			"phpstan/extension-installer": true
		}
	},
	"autoload-dev": {
		"psr-4": {
			"DERHANSEN\\SfEventMgt\\Tests\\": "../Tests"
		}
	}
}
